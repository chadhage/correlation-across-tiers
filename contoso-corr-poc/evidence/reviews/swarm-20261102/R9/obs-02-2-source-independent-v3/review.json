        "sha256": "53927b6d11d6a8090e6c2a157f78eab3fbbd2cb21bde1006e0a5691967f857be",
        "positiveTests": [
          "complete local checker renders one six-span tree and A/B/C PASS only under the named rehearsal profile",
          "actual loopback HTTP intake scans before projection, merges one tree, closes the receiver and grants local-only provenance",
          "safe incremental capture callbacks are immutable, per-payload and awaited before acceptance"
        ],
        "negativeTests": [
          "seeded split, duplicate, parent and every missing-hop control fail without modifying original captures",
          "untouched full-chain assertion rejects Gateway-free rows even after local A/B/C passed",
          "unsafe originals never reach an incremental callback and callback failures poison all acceptance",
          "mixed caller envelopes cannot inherit an original loopback capture provenance",
          "an empty original loopback capture cannot lend provenance to caller-only spans"
        ]
      },
