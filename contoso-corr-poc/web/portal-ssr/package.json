{
  "name": "@contoso/portal-ssr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.4 <25" },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json && vite build --config vite.portal.config.ts && node scripts/package-cohost.mjs",
    "package:cohost": "node scripts/package-cohost.mjs",
    "package:deployment": "node scripts/package-deployment.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "npm run build && vite build --config tests/browser/vite.fixture.config.ts && playwright test --config playwright.config.ts",
    "start": "node dist/bootstrap.js",
    "start:windows": "powershell -NoProfile -File start.ps1"
  },
  "dependencies": {
    "@azure/identity": "4.14.1",
    "@azure/logger": "1.4.0",
    "@microsoft/applicationinsights-web": "3.4.5",
    "@microsoft/opentelemetry": "1.5.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/instrumentation-http": "0.221.0",
    "@opentelemetry/resources": "2.12.0",
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
