<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>4.1.2</version><relativePath/></parent>
  <groupId>com.contoso</groupId><artifactId>contoso-corr-poc</artifactId><version>1.0.0</version><packaging>pom</packaging>
  <name>Contoso correlation POC</name>
  <properties>
    <java.version>25</java.version><maven.compiler.release>25</maven.compiler.release>
    <opentelemetry.version>1.65.0</opentelemetry.version>
    <azure-sdk-bom.version>1.3.9</azure-sdk-bom.version>
    <lettuce.version>7.9.0.RELEASE</lettuce.version><postgresql.version>42.7.14</postgresql.version>
    <redis-authx.version>0.2.0</redis-authx.version><azure-functions.version>3.3.0</azure-functions.version>
    <azure-functions-maven-plugin.version>1.42.0</azure-functions-maven-plugin.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-10-31T00:00:00Z</project.build.outputTimestamp>
    <contoso.sdk.trace.compiler.include>com.contoso:compiler-sdk-disabled</contoso.sdk.trace.compiler.include>
    <contoso.sdk.common.compiler.include>com.contoso:compiler-sdk-disabled</contoso.sdk.common.compiler.include>
    <contoso.sdk.spi.compiler.include>com.contoso:compiler-sdk-disabled</contoso.sdk.spi.compiler.include>
  </properties>
  <modules>
    <module>services/correlation-core</module><module>services/security-core</module>
    <module>services/inventory-data</module><module>workers/messaging-core</module>
    <module>services/inventory-api</module><module>services/orders-api</module>
    <module>workers/fulfillment</module><module>workers/notify</module>
    <module>workers/aggregator</module><module>workers/replay</module>
    <module>extensions/parent-safe-sampler</module>
  </modules>
  <dependencyManagement><dependencies>
    <dependency><groupId>com.azure</groupId><artifactId>azure-sdk-bom</artifactId><version>${azure-sdk-bom.version}</version><type>pom</type><scope>import</scope></dependency>
    <dependency><groupId>redis.clients.authentication</groupId><artifactId>redis-authx-entraid</artifactId><version>${redis-authx.version}</version></dependency>
    <dependency><groupId>com.microsoft.azure.functions</groupId><artifactId>azure-functions-java-library</artifactId><version>${azure-functions.version}</version></dependency>
    <dependency><groupId>com.contoso</groupId><artifactId>contoso-correlation-core</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.contoso</groupId><artifactId>security-core</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.contoso</groupId><artifactId>inventory-data</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.contoso</groupId><artifactId>messaging-core</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.contoso</groupId><artifactId>contoso-parent-safe-sampler</artifactId><version>1.1.0</version></dependency>
  </dependencies></dependencyManagement>
  <build>
    <pluginManagement><plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.15.0</version><configuration><release>25</release></configuration></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.6</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId><version>3.5.6</version></plugin>
      <plugin><groupId>com.microsoft.azure</groupId><artifactId>azure-functions-maven-plugin</artifactId><version>${azure-functions-maven-plugin.version}</version></plugin>
      <plugin><groupId>org.cyclonedx</groupId><artifactId>cyclonedx-maven-plugin</artifactId><version>2.9.3</version><configuration>
        <includeCompileScope>true</includeCompileScope><includeRuntimeScope>true</includeRuntimeScope>
        <includeProvidedScope>false</includeProvidedScope><includeTestScope>false</includeTestScope>
        <includeLicenseText>false</includeLicenseText><outputDirectory>${project.build.directory}/sbom</outputDirectory>
      </configuration></plugin>
    </plugins></pluginManagement>
    <plugins><plugin>
      <groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId><version>3.6.3</version>
      <executions><execution><id>gate-02-api-only</id><goals><goal>enforce</goal></goals><configuration><rules>
        <requireJavaVersion><version>[25,26)</version></requireJavaVersion>
        <requireMavenVersion><version>[3.10.0,4)</version></requireMavenVersion>
        <bannedDependencies><searchTransitive>true</searchTransitive><excludes>
          <exclude>io.opentelemetry:opentelemetry-sdk*</exclude><exclude>io.opentelemetry:opentelemetry-exporter*</exclude>
          <exclude>io.opentelemetry.javaagent:*</exclude><exclude>com.microsoft.azure:applicationinsights*</exclude>
          <exclude>com.azure:azure-monitor-opentelemetry*</exclude><exclude>com.azure:azure-core-tracing-opentelemetry</exclude>
          <exclude>com.microsoft.azure.functions:azure-functions-java-opentelemetry</exclude>
          <exclude>io.micrometer:micrometer-tracing*</exclude><exclude>org.springframework.boot:spring-boot-starter-opentelemetry</exclude>
        </excludes><includes>
          <include>${contoso.sdk.trace.compiler.include}</include>
          <include>${contoso.sdk.common.compiler.include}</include>
          <include>${contoso.sdk.spi.compiler.include}</include>
        </includes></bannedDependencies>
      </rules></configuration></execution></executions>
    </plugin></plugins>
  </build>
</project>
