{
  "schema": "contoso.expected-boundary-map.v1",
  "workload": "contoso-corr",
  "environment": "poc",
  "coreSynchronousBoundaries": [
    "storefront.http",
    "gateway.request",
    "gateway.backend",
    "orders.request",
    "orders.inventory",
    "inventory.request",
    "postgres.logical",
    "redis.logical"
  ],
  "spans": [
    { "id": "storefront.http", "roleName": "contoso-storefront-spa", "semanticKind": "CLIENT", "label": "Contoso Storefront HTTP dependency" },
    { "id": "portal.request", "roleName": "contoso-portal-ssr", "semanticKind": "SERVER", "label": "Contoso Portal SSR render" },
    { "id": "portal.gateway", "roleName": "contoso-portal-ssr", "semanticKind": "CLIENT", "label": "Contoso Portal Gateway call" },
    { "id": "gateway.request", "roleName": "contoso-corr-poc-apim", "semanticKind": "SERVER", "label": "Contoso Gateway request", "roleMappingRequiresLiveEvidence": true },
    { "id": "gateway.backend", "roleName": "contoso-corr-poc-apim", "semanticKind": "CLIENT", "label": "Contoso Gateway backend dependency", "roleMappingRequiresLiveEvidence": true },
    { "id": "orders.request", "roleName": "contoso-orders-api", "semanticKind": "SERVER", "label": "Contoso Orders request" },
    { "id": "orders.validation", "roleName": "contoso-orders-api", "semanticKind": "INTERNAL", "label": "Contoso Orders validation" },
    { "id": "orders.inventory", "roleName": "contoso-orders-api", "semanticKind": "CLIENT", "label": "Contoso Orders Inventory call" },
    { "id": "inventory.request", "roleName": "contoso-inventory-api", "semanticKind": "SERVER", "label": "Contoso Inventory request" },
    { "id": "postgres.logical", "roleName": "contoso-inventory-api", "semanticKind": "CLIENT", "label": "Contoso PostgreSQL logical operation", "serverContinuation": false },
    { "id": "redis.logical", "roleName": "contoso-inventory-api", "semanticKind": "CLIENT", "label": "Contoso Managed Redis logical operation", "serverContinuation": false },
    { "id": "orders.servicebus.send", "roleName": "contoso-orders-api", "semanticKind": "PRODUCER", "label": "Contoso Service Bus SEND" },
    { "id": "orders.eventgrid.send", "roleName": "contoso-orders-api", "semanticKind": "PRODUCER", "label": "Contoso CloudEvent SEND" },
    { "id": "orders.eventhubs.send", "roleName": "contoso-orders-api", "semanticKind": "PRODUCER", "label": "Contoso Event Hubs SEND" },
    { "id": "orders.storage.send", "roleName": "contoso-orders-api", "semanticKind": "PRODUCER", "label": "Contoso Storage Queue SEND" },
    { "id": "fulfillment.process", "roleName": "contoso-fulfillment-worker", "semanticKind": "CONSUMER", "label": "Contoso Fulfillment PROCESS attempt" },
    { "id": "notify.process", "roleName": "contoso-notify-worker", "semanticKind": "CONSUMER", "label": "Contoso Notify PROCESS attempt" },
    { "id": "fulfillment.result", "roleName": "contoso-fulfillment-worker", "semanticKind": "PRODUCER", "label": "Contoso Fulfillment result SEND" },
    { "id": "notify.result", "roleName": "contoso-notify-worker", "semanticKind": "PRODUCER", "label": "Contoso Notify result SEND" },
    { "id": "aggregator.result", "roleName": "contoso-order-aggregator", "semanticKind": "CONSUMER", "label": "Contoso Aggregator result PROCESS" },
    { "id": "aggregator.batch", "roleName": "contoso-order-aggregator", "semanticKind": "CONSUMER", "label": "Contoso mixed-context batch" },
    { "id": "aggregator.fanin", "roleName": "contoso-order-aggregator", "semanticKind": "INTERNAL", "label": "Contoso fan-in aggregation" },
    { "id": "aggregator.batch.item", "roleName": "contoso-order-aggregator", "semanticKind": "CONSUMER", "label": "Contoso Event Hubs item PROCESS" },
    { "id": "fulfillment.replay.process", "roleName": "contoso-fulfillment-worker", "semanticKind": "CONSUMER", "label": "Contoso Fulfillment replay PROCESS" },
    { "id": "notify.replay.process", "roleName": "contoso-notify-worker", "semanticKind": "CONSUMER", "label": "Contoso Notification replay PROCESS" },
    { "id": "fulfillment.replay.send", "roleName": "contoso-fulfillment-worker", "semanticKind": "PRODUCER", "label": "Contoso Fulfillment replay SEND" },
    { "id": "notify.replay.send", "roleName": "contoso-notify-worker", "semanticKind": "PRODUCER", "label": "Contoso Notification replay SEND" },
    { "id": "fulfillment.rejected", "roleName": "contoso-fulfillment-worker", "semanticKind": "CONSUMER", "label": "Contoso Fulfillment rejected PROCESS" },
    { "id": "notify.rejected", "roleName": "contoso-notify-worker", "semanticKind": "CONSUMER", "label": "Contoso Notification rejected PROCESS" },
    { "id": "aggregator.rejected", "roleName": "contoso-order-aggregator", "semanticKind": "CONSUMER", "label": "Contoso Aggregator rejected PROCESS" }
  ],
  "edges": [
    { "from": "storefront.http", "to": "gateway.request", "type": "parent", "path": "spa" },
    { "from": "portal.request", "to": "portal.gateway", "type": "parent", "path": "ssr" },
    { "from": "portal.gateway", "to": "gateway.request", "type": "parent", "path": "ssr" },
    { "from": "gateway.request", "to": "gateway.backend", "type": "parent", "path": "sync" },
    { "from": "gateway.backend", "to": "orders.request", "type": "parent", "path": "sync" },
    { "from": "orders.request", "to": "orders.validation", "type": "parent", "path": "sync" },
    { "from": "orders.request", "to": "orders.inventory", "type": "parent", "path": "sync" },
    { "from": "orders.inventory", "to": "inventory.request", "type": "parent", "path": "sync" },
    { "from": "inventory.request", "to": "postgres.logical", "type": "parent", "path": "sync" },
    { "from": "inventory.request", "to": "redis.logical", "type": "parent", "path": "sync" },
    { "from": "orders.servicebus.send", "to": "fulfillment.process", "type": "parent", "path": "servicebus" },
    { "from": "orders.servicebus.send", "to": "notify.process", "type": "parent", "path": "fanout" },
    { "from": "orders.eventgrid.send", "to": "fulfillment.process", "type": "parent", "path": "eventgrid" },
    { "from": "orders.storage.send", "to": "fulfillment.process", "type": "parent", "path": "storage" },
    { "from": "fulfillment.process", "to": "fulfillment.result", "type": "link", "path": "result-outbox" },
    { "from": "notify.process", "to": "notify.result", "type": "link", "path": "result-outbox" },
    { "from": "fulfillment.result", "to": "aggregator.result", "type": "parent", "path": "results" },
    { "from": "notify.result", "to": "aggregator.result", "type": "parent", "path": "results" },
    { "from": "fulfillment.process", "to": "aggregator.fanin", "type": "link", "path": "fanin" },
    { "from": "notify.process", "to": "aggregator.fanin", "type": "link", "path": "fanin" },
    { "from": "fulfillment.result", "to": "aggregator.fanin", "type": "link", "path": "fanin" },
    { "from": "notify.result", "to": "aggregator.fanin", "type": "link", "path": "fanin" },
    { "from": "orders.eventhubs.send", "to": "aggregator.batch", "type": "link", "path": "mixed-batch", "cardinality": "each-contributor" },
    { "from": "aggregator.batch", "to": "aggregator.batch.item", "type": "parent", "path": "mixed-batch-items", "cardinality": "each-item" },
    { "from": "orders.servicebus.send", "to": "fulfillment.replay.process", "type": "link", "path": "replay-original" },
    { "from": "orders.servicebus.send", "to": "notify.replay.process", "type": "link", "path": "replay-original" },
    { "from": "orders.servicebus.send", "to": "fulfillment.replay.send", "type": "link", "path": "replay-outbox-original" },
    { "from": "orders.servicebus.send", "to": "notify.replay.send", "type": "link", "path": "replay-outbox-original" },
    { "from": "orders.storage.send", "to": "fulfillment.replay.process", "type": "link", "path": "storage-replay-original" },
    { "from": "orders.storage.send", "to": "fulfillment.replay.send", "type": "link", "path": "storage-replay-outbox-original" },
    { "from": "fulfillment.replay.send", "to": "fulfillment.process", "type": "parent", "path": "replayed-delivery" },
    { "from": "notify.replay.send", "to": "notify.process", "type": "parent", "path": "replayed-delivery" }
  ],
  "deliberateRoots": [
    { "boundary": "portal.request", "reason": "A document render and browser page telemetry are distinct roots unless context is actually propagated." },
    { "boundary": "aggregator.fanin", "reason": "Complete persisted contributors are links; arrival order never selects a parent." },
    { "boundary": "aggregator.batch", "reason": "Mixed-message contexts are bounded links; the first message is never parent." },
    { "boundary": "fulfillment.result", "reason": "The result SEND is a new root linked to the persisted actual Fulfillment PROCESS context." },
    { "boundary": "notify.result", "reason": "The result SEND is a new root linked to the persisted actual Notification PROCESS context." },
    { "boundary": "fulfillment.replay.process", "reason": "The actual Fulfillment identity processes its requested DLQ source as new work linked to the original context." },
    { "boundary": "notify.replay.process", "reason": "The actual Notification identity processes its requested DLQ source as new work linked to the original context." },
    { "boundary": "fulfillment.replay.send", "reason": "The owning Fulfillment outbox starts new SEND work linked to the original publication context, not an invented Orders actor." },
    { "boundary": "notify.replay.send", "reason": "The owning Notification outbox starts new SEND work linked to the original publication context, not an invented Orders actor." }
  ],
  "conditionalRoots": [
    { "boundary": "gateway.request", "allowedDispositions": ["absent", "duplicate", "invalid"], "policyRef": "apim/policies/fragments/contoso-context-v1.xml", "receiptType": "source-bound-native-trust-root", "parentMustBeNull": true, "sourceProofRequired": true },
    { "boundary": "orders.request", "allowedDispositions": ["absent", "invalid"], "policyRef": "ADR-A03/agent-framework-http-extraction", "receiptType": "source-bound-native-trust-root", "parentMustBeNull": true, "sourceProofRequired": true },
    { "boundary": "inventory.request", "allowedDispositions": ["absent", "invalid"], "policyRef": "ADR-A03/agent-framework-http-extraction", "receiptType": "source-bound-native-trust-root", "parentMustBeNull": true, "sourceProofRequired": true },
    { "boundary": "fulfillment.process", "allowedDispositions": ["ABSENT", "INVALID_CONTEXT"], "policyRef": "workers/messaging-core/TraceContexts.extract", "receiptType": "source-bound-native-trust-root", "parentMustBeNull": true, "sourceProofRequired": true },
    { "boundary": "notify.process", "allowedDispositions": ["ABSENT", "INVALID_CONTEXT"], "policyRef": "workers/messaging-core/TraceContexts.extract", "receiptType": "source-bound-native-trust-root", "parentMustBeNull": true, "sourceProofRequired": true },
    { "boundary": "aggregator.batch.item", "allowedDispositions": ["ABSENT", "INVALID_CONTEXT"], "policyRef": "workers/messaging-core/TraceContexts.extract", "receiptType": "source-bound-native-trust-root", "parentMustBeNull": true, "sourceProofRequired": true },
    { "boundary": "fulfillment.rejected", "allowedDispositions": ["UNTRUSTED_PUBLICATION", "INVALID_ENVELOPE", "INVALID_CARRIER", "ENVELOPE_TOO_LARGE"], "policyRef": "workers/messaging-core/AsyncProcessor.reject", "receiptType": "source-bound-native-trust-root", "parentMustBeNull": true, "sourceProofRequired": true },
    { "boundary": "notify.rejected", "allowedDispositions": ["UNTRUSTED_PUBLICATION", "INVALID_ENVELOPE", "INVALID_CARRIER", "ENVELOPE_TOO_LARGE"], "policyRef": "workers/messaging-core/AsyncProcessor.reject", "receiptType": "source-bound-native-trust-root", "parentMustBeNull": true, "sourceProofRequired": true },
    { "boundary": "aggregator.rejected", "allowedDispositions": ["UNTRUSTED_PUBLICATION", "INVALID_CARRIER", "INVALID_ENVELOPE", "ENVELOPE_TOO_LARGE"], "policyRef": "workers/messaging-core/AsyncProcessor.quarantine", "receiptType": "source-bound-native-trust-root", "parentMustBeNull": true, "sourceProofRequired": true }
  ],
  "expectedRemoteBoundaries": [
    { "id": "servicebus", "reason": "Broker delivery does not imply emitted broker spans; retain actual producer context." },
    { "id": "eventgrid", "reason": "Authenticated public-TLS relay into the fixed Service Bus entity is not a broker span." },
    { "id": "eventhubs", "reason": "Partition/batch transport is represented by actual producer/consumer links." },
    { "id": "storage", "reason": "Queue envelope propagation is not a native Storage server trace." },
    { "id": "identity", "reason": "Entra/managed-identity token activity is not business trace authority." },
    { "id": "keyvault", "reason": "Secret retrieval has its own safe CLIENT boundary, never secret-value capture." }
  ],
  "linkLimit": 32,
  "constraints": {
    "neverPromoteUnsampledContinuation": true,
    "positiveFidelityVectorIsSampled": true,
    "unsampledVectorDoesNotClaimCompleteExport": true,
    "noArbitraryBatchParent": true,
    "noDatabaseServerContinuation": true,
    "noExpectedValuesSubstitutedIntoObservedRows": true,
    "conditionalRootsRequireActualNativeReceipts": true,
    "invalidStateAloneNeverBreaksValidParent": true,
    "businessIdReplacementNeverChangesTraceContext": true,
    "identityClientSpansMayExistWithoutIdentityHeaderPropagation": true,
    "rootLinkSamplingPolicy": "DROP_VALID_UNSAMPLED_PARENT_AND_ALL_VALID_UNSAMPLED_LINKS"
  }
}
