{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:contoso:message-envelope:v1",
  "title": "Contoso bounded synthetic-work envelope v1",
  "description": "UTF-8 encoded envelope is limited to 32768 bytes before optional Storage Queue Base64 encoding. Context syntax is parsed by the W3C propagator; invalid context becomes a declared root/rejection, never a claimed authenticated producer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "traceparent", "tracestate", "business.invocation_id", "messageId", "causationId", "workflowId", "kind", "replayOf", "payload"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "traceparent": { "type": ["string", "null"], "maxLength": 512 },
    "tracestate": { "type": ["string", "null"], "maxLength": 512 },
    "business.invocation_id": { "$ref": "#/$defs/id" },
    "messageId": { "$ref": "#/$defs/id" },
    "causationId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "workflowId": { "$ref": "#/$defs/id" },
    "kind": { "enum": ["ORDER", "RESULT", "BATCH"] },
    "replayOf": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderId", "sku", "quantity", "scenario", "contributor"],
      "properties": {
        "orderId": { "$ref": "#/$defs/id" },
        "sku": { "type": "string", "pattern": "^CONTOSO-00[1-5]$" },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 100 },
        "scenario": { "enum": ["SYNC", "RETRY", "DLQ", "FAN_OUT", "FAN_IN", "BATCH", "EVENT_GRID", "STORAGE_QUEUE", "PRIVACY", "SAMPLING"] },
        "contributor": { "enum": ["FULFILLMENT", "NOTIFY", null] }
      }
    }
  },
  "allOf": [{
    "if": { "properties": { "kind": { "const": "RESULT" } } },
    "then": { "properties": { "payload": { "properties": { "contributor": { "enum": ["FULFILLMENT", "NOTIFY"] } } } } },
    "else": { "properties": { "payload": { "properties": { "contributor": { "type": "null" } } } } }
  }],
  "$defs": {
    "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "minLength": 36, "maxLength": 36 }
  },
  "x-contoso-max-utf8-bytes": 32768,
  "x-contoso-replay-rule": "replayOf equals causationId, differs from messageId, and references a protected original publication; runtime enforces the cross-field rule"
}
