<policies>
  <inbound>
    <cors allow-credentials="false" terminate-unmatched-request="true">
      <allowed-origins>__FRONTEND_ORIGINS__</allowed-origins>
      <allowed-methods preflight-result-max-age="300"><method>GET</method><method>POST</method></allowed-methods>
      <allowed-headers>
        <header>Authorization</header>
        <header>Content-Type</header>
        <header>Request-Context</header>
        <header>traceparent</header>
        <header>tracestate</header>
        <header>x-business-invocation-id</header>
      </allowed-headers>
      <expose-headers>__EXPOSED_HEADERS__</expose-headers>
    </cors>
  </inbound>
  <backend>
    <forward-request timeout="{{contoso-backend-timeout}}" follow-redirects="false" http-version="1" />
  </backend>
  <outbound />
  <on-error>
    <choose>
      <when condition="@(context.LastError.Source == &quot;validate-azure-ad-token&quot;)">
        <return-response>
          <set-status code="401" reason="Unauthorized" />
          <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
          <set-body>{"schemaVersion":1,"code":"AUTHENTICATION_FAILED"}</set-body>
        </return-response>
      </when>
      <otherwise>
        <return-response>
          <set-status code="502" reason="Bad Gateway" />
          <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
          <set-body>{"schemaVersion":1,"code":"GATEWAY_BACKEND_FAILURE"}</set-body>
        </return-response>
      </otherwise>
    </choose>
  </on-error>
</policies>
