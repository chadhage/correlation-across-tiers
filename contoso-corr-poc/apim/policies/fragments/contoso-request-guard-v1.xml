<fragment>
  <choose>
    <when condition="@(context.Request.OriginalUrl.Query.Count != 0)">
      <return-response>
        <set-status code="400" reason="Bad Request" />
        <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
        <set-body>{"schemaVersion":1,"code":"QUERY_PARAMETERS_NOT_ALLOWED"}</set-body>
      </return-response>
    </when>
  </choose>
</fragment>
